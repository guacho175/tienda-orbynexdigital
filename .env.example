# =========================================================================
# ORBYNEX MINI-COMMERCE - CONFIGURACIÓN DE VARIABLES DE ENTORNO DE EJEMPLO
# =========================================================================
# Copia este archivo a ".env" en la raíz del proyecto para desarrollo local:
#   $ cp .env.example .env
#
# IMPORTANTE: Nunca expongas este archivo configurado ni el archivo ".env" en
# repositorios públicos o carpetas compartidas de producción.
# =========================================================================

# -------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS (Disponibles en el Navegador / Prefijo VITE_)
# -------------------------------------------------------------------------
# Estas variables son inyectadas en el bundle del cliente por Vite.
# No deben contener ninguna clave privada, tokens secretos ni contraseñas.

# URL del backend de tu proyecto de Supabase (ej. https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Identificador de proyecto de tu instancia de Supabase
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_ID=your-project-id

# Clave pública de Supabase (anon key). Es segura para el cliente, respeta RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# URL pública canónica de la aplicación frontend.
# Debe coincidir con Supabase Auth > URL Configuration > Site URL / Redirect URLs.
# VITE_APP_PUBLIC_URL se usa en el navegador para emailRedirectTo.
VITE_APP_PUBLIC_URL=https://your-shop-domain.example
APP_PUBLIC_URL=https://your-shop-domain.example

# Seguridad de desarrollo: bloquea registros desde localhost si VITE_SUPABASE_URL
# apunta a un Supabase remoto. Cambialo a true solo para pruebas deliberadas.
VITE_ALLOW_REMOTE_AUTH_SIGNUP_FROM_LOCAL=false

# -------------------------------------------------------------------------
# 2. VARIABLES EXCLUSIVAS DEL SERVIDOR (BACKEND ONLY - NUNCA EXPONER AL CLIENTE)
# -------------------------------------------------------------------------
# Estas variables solo se cargan en funciones serverless y Server Components.

# CLAVE MAESTRA DE SUPABASE (Service Role Key)
# ¡¡PELIGRO DE SEGURIDAD CRÍTICO!! Esta clave se salta todas las políticas RLS.
# NUNCA la importes en archivos de rutas cliente (.tsx) ni utilices el prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cadena de conexión directa a PostgreSQL (para migraciones o scripts de administración)
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Token de seguridad para autenticar la ejecución de tareas cron de mantenimiento
# (ej. UUID v4 generado aleatoriamente)
CRON_SECRET=your-cron-secret-uuid

# -------------------------------------------------------------------------
# 3. CONFIGURACIÓN DE LA PASARELA DE PAGOS (FLOW API)
# -------------------------------------------------------------------------
# Variables privadas y URLs necesarias para la pasarela Flow.

# Identificador de comercio Flow (proporcionado en tu panel de Flow)
FLOW_API_KEY=your-flow-api-key

# Clave secreta privada para firmar las llamadas transaccionales
FLOW_SECRET_KEY=your-flow-secret-key

# URL base del API de Flow:
#   Desarrollo/Sandbox: https://sandbox.flow.cl/api
#   Producción:         https://www.flow.cl/api
FLOW_BASE_URL=https://sandbox.flow.cl/api

# URLs de retorno y webhooks transaccionales
FLOW_RETURN_URL=http://localhost:8080/checkout/resultado
FLOW_CONFIRMATION_URL=http://localhost:8080/api/flow/confirm
